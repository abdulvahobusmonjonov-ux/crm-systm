generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  OPERATOR
  MENTOR
  RECEPTION
  ACCOUNTANT
  // Session-only sentinel for Lead-based student logins — never stored on a real User row.
  STUDENT
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  TRIAL_BOOKED
  TRIAL_COMPLETED
  ENROLLED
  POSTPONED
  LOST
}

enum TimePreference {
  MORNING
  AFTERNOON
  EVENING
  FLEXIBLE
}

enum LeadSource {
  INSTAGRAM
  TELEGRAM
  FACEBOOK
  TIKTOK
  REFERRAL
  WEBSITE
  WALK_IN
  PHONE_CALL
  OTHER
}

enum ReminderStatus {
  PENDING
  DONE
  MISSED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  email        String?  @unique
  phone        String?
  passwordHash String
  role         Role     @default(OPERATOR)
  isActive     Boolean  @default(true)
  avatarUrl    String?

  salary           Decimal? @db.Decimal(12, 2)
  subject          String?
  rating           Int      @default(0)

  language  String?
  gender    String?
  birthDate DateTime? @db.Date
  region    String?
  district  String?
  instagram String?
  telegram  String?

  canManageLeads   Boolean @default(true)
  canManageCourses Boolean @default(false)
  canManageUsers   Boolean @default(false)
  canViewReports   Boolean @default(false)
  canExportData    Boolean @default(false)

  canSeePayments         Boolean @default(false)
  canManagePayments      Boolean @default(false)
  canSeeStudentContacts  Boolean @default(true)
  canManageAttendance    Boolean @default(false)
  canManageGrades        Boolean @default(false)
  canSeeReports          Boolean @default(false)
  canManageExpenses      Boolean @default(false)

  leads        Lead[]     @relation("AssignedTo")
  createdLeads Lead[]     @relation("CreatedBy")
  reminders    Reminder[]
  activities   Activity[]
  groupsTeaching Group[]  @relation("GroupTeacher")
  paymentsCreated Payment[] @relation("PaymentCreatedBy")
  attendanceMarked Attendance[] @relation("AttendanceBy")
  expensesCreated Expense[] @relation("ExpenseCreatedBy")
  incomesCreated  Income[]  @relation("IncomeCreatedBy")
  salaryRecords   SalaryRecord[] @relation("SalaryUser")
  salaryRecordsCreated SalaryRecord[] @relation("SalaryCreatedBy")
  examsCreated    Exam[]    @relation("ExamCreatedBy")
  coinTxCreated   CoinTx[]  @relation("CoinCreatedBy")
  lessonScoresCreated LessonScore[] @relation("LessonScoreCreatedBy")
  exercisesCreated Exercise[] @relation("ExerciseCreatedBy")
  homeworkCreated HomeworkSubmission[] @relation("HomeworkCreatedBy")
  staffAttendances StaffAttendance[] @relation("StaffAttendanceUser")
  tasksAssigned    Task[]   @relation("TaskAssignedTo")
  tasksCreated     Task[]   @relation("TaskCreatedBy")
  permissions      UserPermission[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
}

model Course {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  description    String?
  durationMonths Int
  price          Decimal @db.Decimal(10, 2)
  currency       String  @default("UZS")
  isActive       Boolean @default(true)
  color          String?

  leads  Lead[]
  groups Group[]
  exams  Exam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimeSlot {
  id        String  @id @default(cuid())
  startTime String
  endTime   String
  label     String
  isActive  Boolean @default(true)

  leads Lead[]
}

model Lead {
  id String @id @default(cuid())

  fullName       String
  phone          String
  phoneSecondary String?
  email          String?
  age            Int?
  address        String?
  parentName     String?
  parentPhone    String?
  telegramChatId String?
  birthDate      DateTime? @db.Date
  loginCode      String?
  coins          Int      @default(0)
  frozenAt       DateTime?
  frozenUntil    DateTime?
  referrerName   String?
  referrerPhone  String?
  isArchived     Boolean  @default(false)
  discountPercent Int     @default(0)

  courseId String?
  course   Course?   @relation(fields: [courseId], references: [id])

  timeSlotId String?
  timeSlot   TimeSlot? @relation(fields: [timeSlotId], references: [id])

  timePreference TimePreference @default(FLEXIBLE)
  preferredDays  String?
  lessonTime     String?

  stageId String?
  stage   Stage?  @relation(fields: [stageId], references: [id])

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  status        LeadStatus @default(NEW)
  source        LeadSource @default(OTHER)
  sourceDetails String?

  notes String? @db.Text

  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  reminders  Reminder[]
  activities Activity[]
  tags       Tag[]
  payments   Payment[]
  attendances Attendance[]
  scores     Score[]
  coinTxs    CoinTx[]
  lessonScores LessonScore[]
  exerciseScores ExerciseScore[]
  homeworkSubmissions HomeworkSubmission[]

  trialDate       DateTime?
  enrolledAt      DateTime?
  lastContactedAt DateTime?
  isPinned        Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([phone])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([courseId])
  @@index([isArchived])
}

model Reminder {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title       String
  description String?

  remindAt DateTime
  status   ReminderStatus @default(PENDING)

  notifyBrowser  Boolean @default(true)
  notifyTelegram Boolean @default(false)
  notifyEmail    Boolean @default(false)

  notifiedAt  DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([remindAt])
  @@index([status])
  @@index([userId])
  @@index([leadId])
}

model Activity {
  id     String  @id @default(cuid())
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  action  String
  details Json?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#3B82F6")
  leads Lead[]
  tasks Task[]
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt
}

model PaymentType {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Exam {
  id           String   @id @default(cuid())
  title        String
  type         String   @default("exam")
  courseId     String?
  course       Course?  @relation(fields: [courseId], references: [id])
  groupId      String?
  group        Group?   @relation(fields: [groupId], references: [id])
  date         DateTime @db.Date
  maxScore     Int      @default(100)
  passingScore Int?
  section      String?
  createdById  String
  createdBy    User     @relation("ExamCreatedBy", fields: [createdById], references: [id])
  scores       Score[]
  createdAt    DateTime @default(now())

  @@index([date])
}

model Score {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  score     Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, leadId])
  @@index([leadId])
}

// "Ballar" tab — one 0-100 score per (group, student, lesson date), independent of Exam/Score.
model LessonScore {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  score       Int
  note        String?
  createdById String
  createdBy   User     @relation("LessonScoreCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([groupId, leadId, date])
  @@index([groupId, date])
  @@index([leadId, date])
}

// "Mashqlar" tab — a teacher adds an exercise on a lesson date, then scores each student on it.
model Exercise {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  title       String
  createdById String
  createdBy   User     @relation("ExerciseCreatedBy", fields: [createdById], references: [id])
  scores      ExerciseScore[]
  submissions HomeworkSubmission[]
  createdAt   DateTime @default(now())

  @@index([groupId, date])
}

model ExerciseScore {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  score      Int
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([exerciseId, leadId])
  @@index([leadId])
}

// "Uy vazifalari" tab — a student's submission for an exercise, reviewed/graded by the teacher.
model HomeworkSubmission {
  id          String    @id @default(cuid())
  exerciseId  String
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content     String?   @db.Text
  status      String    @default("unchecked") // unchecked | checked
  grade       Int?
  teacherNote String?
  submittedAt DateTime  @default(now())
  checkedAt   DateTime?
  createdById String
  createdBy   User      @relation("HomeworkCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([exerciseId, leadId])
  @@index([exerciseId])
  @@index([leadId])
  @@index([status])
}

model CoinTx {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  amount      Int
  reason      String
  createdById String
  createdBy   User     @relation("CoinCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([leadId])
}

model Holiday {
  id    String   @id @default(cuid())
  date  DateTime @db.Date @unique
  name  String
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  userName  String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Group {
  id        String    @id @default(cuid())
  name      String
  courseId  String?
  course    Course?   @relation(fields: [courseId], references: [id])
  teacherId String?
  teacher   User?     @relation("GroupTeacher", fields: [teacherId], references: [id])
  days      String?
  timeFrom  String?
  timeTo    String?
  room      String?
  startDate DateTime?
  notes     String?   @db.Text
  isActive  Boolean   @default(true)
  isArchived Boolean  @default(false)
  leads     Lead[]
  payments  Payment[]
  attendances Attendance[]
  exams     Exam[]
  lessonScores LessonScore[]
  exercises Exercise[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Attendance {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  status      String   @default("present")
  note        String?
  createdById String
  createdBy   User     @relation("AttendanceBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([groupId, leadId, date])
  @@index([groupId, date])
  @@index([leadId, date])
}

model Payment {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  discount    Decimal? @db.Decimal(12, 2)
  currency    String   @default("UZS")
  method      String   @default("cash")
  type        String   @default("tuition")
  forMonth    String?
  note        String?
  paidAt      DateTime @default(now())
  createdById String
  createdBy   User     @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([paidAt])
  @@index([forMonth])
  @@index([createdAt])
}

model Stage {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366f1")
  order     Int      @default(0)
  isWon     Boolean  @default(false)
  isLost    Boolean  @default(false)
  leads     Lead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Expense {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  category    String
  note        String?
  spentAt     DateTime @default(now())
  createdById String
  createdBy   User     @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([spentAt])
}

model Income {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  source      String
  note        String?
  receivedAt  DateTime @default(now())
  createdById String
  createdBy   User     @relation("IncomeCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([receivedAt])
}

model SalaryRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("SalaryUser", fields: [userId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  month       String
  type        String   @default("salary")
  note        String?
  paidAt      DateTime @default(now())
  createdById String
  createdBy   User     @relation("SalaryCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([month])
}

// Full ruxsatlar (permissions) catalog — seeded from src/lib/permission-catalog.ts.
model Permission {
  id       String   @id @default(cuid())
  module   String
  action   String
  label    String
  tier     String
  createdAt DateTime @default(now())

  grants   UserPermission[]

  @@unique([module, action])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, permissionId])
  @@index([userId])
}

model StaffAttendance {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("StaffAttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  status    String    @default("absent")
  note      String?
  createdAt DateTime  @default(now())

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
}

model Task {
  id           String     @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus @default(TODO)
  type         String?
  assignedToId String?
  assignedTo   User?      @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdById  String?
  createdBy    User?      @relation("TaskCreatedBy", fields: [createdById], references: [id])
  dueDate      DateTime?
  tags         Tag[]
  createdAt    DateTime   @default(now())

  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
}
